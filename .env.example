# Copy to .env and fill in. Never commit .env.

# --- Model: Gemma 4 31B, AMD-hosted ---
# live = call the model (answers are also recorded to data/replay/)
# replay = answer only from recorded responses in data/replay/ (no key, no network)
# cached = replay when recorded, otherwise live; mock = fake answers for tests
LLM_MODE=replay
# AMD Token Factory (OpenAI-compatible, team key). Our own vLLM on an MI300X droplet instead:
#   LLM_BASE_URL=https://<droplet-ip-with-dashes>.sslip.io/v1, VLM_MODEL=gemma4, TEXT_MODEL=gemma4, LLM_JSON_MODE=json_schema
LLM_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
LLM_API_KEY=
VLM_MODEL=Gemma-4-31B-IT
TEXT_MODEL=Gemma-4-31B-IT
# json_object (Token Factory: no strict json_schema) | json_schema (vLLM guided decoding)
LLM_JSON_MODE=json_object
# Token Factory limits: 20 requests/min and 8 in flight per account
LLM_RPM=18
LLM_CONCURRENCY=6
LLM_RECORD=true

# --- Evolus (https://evolus.ai/developers) ---
EVOLUS_API_BASE=https://api.evolus.ai/api/v1
EVOLUS_API_KEY=
EVOLUS_APP_ID=
EVOLUS_EXTRACTOR_ID=
EVOLUS_WORKFLOW_ID=
EVOLUS_LIBRARY_RULES_ID=
EVOLUS_LIBRARY_PRODUCTS_ID=
# Shared secret Evolus sends on the intake webhook
WEBHOOK_SECRET=

# --- App ---
PUBLIC_BASE_URL=http://localhost:8080
LANGUAGES=en,es,it,de,fr,pt,pl,uk
GPU_HOURLY_USD=1.99
