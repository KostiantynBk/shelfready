# Copy to .env and fill in. Never commit .env.

# --- Model (Gemma 4 on vLLM, AMD Developer Cloud MI300X) ---
# live = call the model; replay = answer from recorded responses in data/replay/ (no GPU); mock = fake answers for tests
LLM_MODE=replay
LLM_BASE_URL=https://<droplet-ip-with-dashes>.sslip.io/v1
LLM_API_KEY=
VLM_MODEL=gemma4
TEXT_MODEL=gemma4

# --- Evolus (https://evolus.ai/developers) ---
EVOLUS_API_BASE=https://api.evolus.ai/api/v1
EVOLUS_API_KEY=
EVOLUS_APP_ID=
EVOLUS_EXTRACTOR_ID=
EVOLUS_WORKFLOW_ID=
EVOLUS_LIBRARY_RULES_ID=
EVOLUS_LIBRARY_PRODUCTS_ID=
# Shared secret Evolus sends on the intake webhook
WEBHOOK_SECRET=

# --- App ---
PUBLIC_BASE_URL=http://localhost:8080
LANGUAGES=en,es,it,de,fr,pt,pl,uk
GPU_HOURLY_USD=1.99
DATA_DIR=./data/runtime
